# ---- copy to docker/.env and edit ----
# Every name below is read by the application code as-is. Renaming a key silently
# disables the feature it belongs to.

# Reverse proxy: ":80" for LAN/dev, "aixin.example.cn" for auto-HTTPS
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_SITE_URL=http://localhost

# Install-time mirror (China): https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# Postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=aixin
POSTGRES_PORT=5432

# JWT secret shared by GoTrue + PostgREST (>= 32 chars): openssl rand -hex 32
JWT_SECRET=change-me-32-bytes-hex

# ---- Data plane ----
# Server-side (runtime). SUPABASE_URL must be reachable from inside the app container.
SUPABASE_URL=http://rest:3000
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-side (baked into the bundle at BUILD time — must be reachable from the user's browser)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=aixin-local

# ---- LLM — any OpenAI-compatible endpoint ----
# Ollama (local):   http://ollama:11434/v1
# Qwen/DashScope:   https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:         https://api.deepseek.com/v1
AIXIN_LLM_BASE_URL=http://ollama:11434/v1
AIXIN_LLM_API_KEY=ollama
AIXIN_LLM_MODEL=qwen2.5:14b-instruct
OLLAMA_PORT=11434

# ---- Receipt signing (Ed25519). Leave blank to run un-signed (honest "unsigned" state). ----
# openssl rand -hex 32
AIXIN_SIGNING_SEED=

# ---- On-chain anchoring (BSC Testnet). Leave blank to run honestly un-anchored. ----
BSC_TESTNET_RPC_URL=
BSC_TESTNET_PRIVATE_KEY=
AUDIT_ANCHOR_CONTRACT_ADDRESS=
ERC8004_IDENTITY_ADDRESS=
ERC8004_REPUTATION_ADDRESS=
ERC8004_VALIDATION_ADDRESS=

# ---- External validator service (optional; SIP falls back to in-process validation) ----
AIXIN_VALIDATOR_URL=

# ---- Optional adapters ----
# Telegram is unreachable from mainland China; leave blank there.
TELEGRAM_API_KEY=
# GitHub bootstrapping (optional, developer tooling only)
GITHUB_API_KEY=
# Gmail delivery needs NO env vars: credentials are entered per user in Dashboard → Adapters.
