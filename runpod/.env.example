# Copy to /workspace/aixin/runpod/aixin.local and replace every <...> value.
# Files ending in .local are ignored by Git; never commit this configuration.

# Existing AiXin backend. These public values are compiled into the browser bundle.
VITE_SUPABASE_URL=<your-backend-url>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
VITE_SUPABASE_PROJECT_ID=<your-project-id>

# Matching server-side backend values.
SUPABASE_URL=<your-backend-url>
SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# Qwen runs privately inside the same RunPod Pod.
AIXIN_LLM_BASE_URL=http://127.0.0.1:11434/v1
AIXIN_LLM_API_KEY=ollama
AIXIN_LLM_MODEL=qwen2.5:14b-instruct

# App process. Expose only port 3000 through RunPod's HTTP proxy.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Optional testnet governance. Leave blank for an honest unanchored state.
BSC_TESTNET_RPC_URL=
BSC_TESTNET_PRIVATE_KEY=
AUDIT_ANCHOR_CONTRACT_ADDRESS=
AIXIN_SIGNING_SEED=
AIXIN_VALIDATOR_URL=
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-if-you-have-one>
